# ──────────────────────────────────────────────
# nginx als HTTPS-Reverse-Proxy vor dem SSO
# Ersetze sso.example.com und die Zertifikatspfade (z. B. von certbot).
# Tipp: Wer keinen nginx betreibt, nimmt Caddy (siehe README, „HTTPS“) – das holt Zertifikate selbst.
# ──────────────────────────────────────────────

server {
    listen 80;
    listen [::]:80;
    server_name sso.example.com;
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name sso.example.com;

    ssl_certificate     /etc/letsencrypt/live/sso.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sso.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        # Grobes Limit pro Client-IP (Zone: nginx/sso-ratelimit.conf nach conf.d/ kopieren)
        limit_req zone=sso_general burst=100 nodelay;
        limit_req_status 429;

        proxy_pass http://127.0.0.1:8122;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Nicht anhängen: ein vom Client mitgeschickter X-Forwarded-For darf nie als Client-IP gelten.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Logo/Favicon-Uploads (bis 1 MB) und Avatare
        client_max_body_size 4m;
    }
}
