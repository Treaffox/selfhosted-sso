# ──────────────────────────────────────────────────────────
# SSO – Server-Konfiguration
#
# Einfachster Weg: `./setup.sh` erzeugt diese Datei samt Geheimnissen für dich.
# Von Hand: Datei nach .env kopieren und die Werte unten ausfüllen.
#
# Hier steht nur, was der Server zum Starten braucht. Name, Logo, Favicon,
# E-Mail-Versand und Cloudflare stellst du nach dem ersten Login im
# Browser ein (Admin → System).
# ──────────────────────────────────────────────────────────

# ─── Adresse ───────────────────────────────────────────────
# Öffentliche Adresse des SSO, ohne Pfad und ohne Schrägstrich am Ende.
# Für Passkeys und sichere Cookies muss sie mit https:// beginnen (lokal zum Testen geht http://localhost:8122).
APP_URL=https://sso.example.com

# ─── Erstes Admin-Konto ───────────────────────────────────
# Wird beim ersten Start angelegt (nur wenn es noch kein Admin-Konto gibt).
# Danach lässt sich das Passwort im Browser ändern; diese Werte werden dann ignoriert.
MASTER_USERNAME=admin
MASTER_PASSWORD=

# ─── Geheimnisse (jeweils: openssl rand -hex 32) ──────────
SESSION_SECRET=
ENCRYPTION_KEY=
# Verschlüsselt personenbezogene Daten in der Datenbank (E-Mail, IPs, Logs, Profilbilder).
# NIE verlieren oder ändern: ohne diesen Schlüssel sind die Daten unlesbar. Sichere ihn getrennt von der Datenbank.
DATA_ENCRYPTION_KEY=

# Signaturschlüssel der OIDC-ID-Tokens (PKCS#8-PEM, einzeilig mit \n). `./setup.sh` erzeugt ihn.
# Leer = bei jedem Start ein neuer Schlüssel (Tokens werden ungültig, JWKS rotiert).
OIDC_PRIVATE_KEY_PEM=

# ─── Datenbank ─────────────────────────────────────────────
# Passwort für den mitgelieferten PostgreSQL-Container (zufällig wählen).
DB_PASSWORD=

# ─── Optional ──────────────────────────────────────────────
# Port, auf dem der SSO lokal lauscht (dein Reverse-Proxy zeigt hierauf). Standard: 8122
# SSO_PORT=8122

# Session-Cookie für Geschwister-Subdomains teilen, z. B. ".example.com".
# Nur nötig für nginx-auth_request-Apps auf Subdomains; für reines OpenID Connect leer lassen.
# COOKIE_DOMAIN=

# Passkey-Domain, falls sie von der Domain in APP_URL abweichen soll (muss eine übergeordnete Domain sein).
# WEBAUTHN_RP_ID=

# Zeitlimits und Anfragelimits (Standardwerte in Klammern)
# SESSION_MAX_AGE_HOURS=24
# TRUSTED_DEVICE_MAX_AGE_DAYS=30
# RATE_LIMIT_LOGIN_MAX=20            # Anmeldeversuche pro IP und Zeitfenster
# RATE_LIMIT_LOGIN_WINDOW_MS=900000
# RATE_LIMIT_EMAIL_MAX=8             # E-Mail-Codes pro Konto und Zeitfenster
# RATE_LIMIT_EMAIL_WINDOW_MS=600000
# RATE_LIMIT_ATTEMPT_MAX=10          # Passwort/MFA-Versuche pro Konto und Zeitfenster
# RATE_LIMIT_ATTEMPT_WINDOW_MS=900000
